# ─── Database ────────────────────────────────────────────────────────────────
# Default matches docker-compose.yml (PostgreSQL 16). Override for hosted DBs.
# On Antideploy the platform injects DATABASE_URL itself — never commit one.
DATABASE_URL="postgresql://agrilink:agrilink@localhost:5432/agrilink?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (production REQUIRES >= 32 chars)
# The server refuses to start in production with a missing/weak JWT_SECRET.
JWT_SECRET="replace-with-openssl-rand-base64-48-output"
# How long a session stays valid (s/m/h/d, max 7d). Default 8h.
# Logout revokes sessions server-side (bumps the user's sessionVersion).
JWT_EXPIRES_IN="8h"

# Demo mode:
#   true  → passwordless role entry works on /login (pick Farmer / Buyer /
#           Admin…) and `prisma db seed` may wipe the demo database.
#   false → role entry answers 403 and the seeder refuses to run. Use this once
#           real accounts + a signup flow exist.
# Never set DEMO_MODE=true on a deployment serving real user data.
# DEMO_MODE=""

# ─── AI / LLM (copilot + lab analysis) ───────────────────────────────────────
# FREE OPENROUTER MODELS ONLY: src/lib/ai.ts rejects any model id that does not
# end in ":free", so a priced model can never be billed. Keep the key
# server-side; never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
# Tried in order when the primary is rate limited / overloaded (comma separated).
OPENROUTER_FALLBACK_MODELS="qwen/qwen3.8-27b:free,nex-agi/nex-n2.5-pro:free,nvidia/nemotron-3-super-120b-a12b:free"
OPENROUTER_SITE_URL="http://localhost:3000"
# With no key (or when every free model is busy) the copilot degrades to its
# offline rule-based engine — still reading real database data, never erroring.

# Seed the demo data once at container start (empty database only).
DEMO_SEED_ON_START="false"
# Optional: force the seeded accounts' password. Unset = unguessable random hash
# per account, because role entry needs no password at all.
# DEMO_SEED_PASSWORD=""

# ─── External integrations (all optional, see README) ───────────────────────
# Map / geocoding for market distances
# GOOGLE_MAPS_API_KEY=""
# SMS / WhatsApp notifications (abstracted in src/lib/notifications.ts)
# SMS_PROVIDER=""            # twilio | msg91 | none
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# MSG91_AUTH_KEY=""
# WHATSAPP_PROVIDER=""       # gupshup | twilio | none
# GUPSHUP_APP_NAME=""
# GUPSHUP_APP_KEY=""
# GUPSHUP_NUMBER=""
# Object storage for photos/documents (S3-compatible, e.g. AWS S3 / MinIO)
# Antideploy containers are replaced on every deploy, so local disk is not
# storage: reports/photos need this before they matter in production.
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# Payment gateway. When set (razorpay|cashfree|...) the demo-ledger
# /api/payments/:id/pay endpoint refuses to act — payments must come from
# verified gateway webhooks instead.
# PAYMENT_PROVIDER=""
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
